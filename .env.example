# ── AI (server-only) ─────────────────────────────────────────────
# Google Gemini is the primary provider (creative, reliable JSON, multimodal).
# Comma-separated key pool rotates on HTTP 429/403. Without any key, the app
# runs in a labeled deterministic-heuristic mode.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
# Ollama Cloud is the secondary provider (used only if no Gemini key is set).
OLLAMA_API_KEY=
# Optional key pool for automatic rate-limit failover: on HTTP 429 the client
# rotates to the next key (sticky — a working key stays current). Comma-separated;
# the single OLLAMA_API_KEY above is appended to the pool if not already listed.
OLLAMA_API_KEYS=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=https://ollama.com

# Optional alternative provider (used only when OLLAMA_API_KEY is empty).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Shopify Global Catalog (server-only) ─────────────────────────
SHOPIFY_CATALOG_ENDPOINT=https://catalog.shopify.com/api/ucp/mcp
# Public HTTPS URL of your hosted UCP agent profile. Leave empty during local
# development to use Shopify's officially hosted example profile for
# connectivity testing. For production, deploy and set:
#   UCP_AGENT_PROFILE_URL=https://YOUR_DEPLOYED_DOMAIN/ucp-profile.json
UCP_AGENT_PROFILE_URL=

# Dev Dashboard credentials for authenticated Catalog mode (higher rate limits).
# Anonymous mode works without them at the lowest rate limits.
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=

# live  → live catalog only; failures surface as errors (never mock)
# mock  → fixtures only, permanent demo banner
# auto  → live first; falls back to labeled mock only when ALLOW_MOCK_FALLBACK=true
CATALOG_MODE=auto
ALLOW_MOCK_FALLBACK=false

# ── Authentication (server-only) ─────────────────────────────────
# NextAuth (Auth.js v5) JWT signing secret. Generate with:
#   openssl rand -base64 32
# Also used to HMAC one-time passcodes. Auth is disabled until this is set.
AUTH_SECRET=
# App origin used to build OAuth callback URLs. For local dev keep the default.
AUTH_URL=http://localhost:3000
# Required when self-hosting (non-Vercel) so NextAuth trusts the host header.
AUTH_TRUST_HOST=true

# Google OAuth credentials (Google Cloud Console → Credentials → OAuth client).
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
# Leave empty to hide/disable the "Continue with Google" button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB — stores users and short-lived OTP codes (TTL-expired).
MONGODB_URI=
MONGODB_DB=shoplens

# Email OTP tuning.
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# Session (JWT cookie) lifetime in days.
SESSION_MAX_AGE_DAYS=7

# Email delivery — Postmark. When both are set, OTP codes are emailed via
# Postmark; otherwise the code is printed to the server console (dev fallback).
# POSTMARK_SERVER_TOKEN is the "Server API token" from your Postmark server.
# EMAIL_FROM must be a Postmark-verified sender signature / domain.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=ShopLens <login@yourdomain.com>
# Optional Postmark message stream (transactional mail uses "outbound").
POSTMARK_MESSAGE_STREAM=outbound

# ── Public (safe for the browser) ────────────────────────────────
NEXT_PUBLIC_APP_NAME=ShopLens
NEXT_PUBLIC_APP_URL=http://localhost:3000
